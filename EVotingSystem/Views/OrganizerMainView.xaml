<UserControl x:Class="EVotingSystem.Views.OrganizerMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Margin="40">

		<!-- Logout button (top-right) -->
		<Button Content="Odjava"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="12,6"
                Background="#C0392B"
                Foreground="White"
                FontWeight="Bold"
                Click="Logout_Click"/>

		<!-- Center content -->
		<StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="300">

			<TextBlock Text="Organizator"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

			<Button Content="Kreiraj novo glasanje"
                    Height="45"
                    FontSize="14"
                    Margin="0,0,0,15"
                    Click="CreateVoting_Click"/>

			<Button Content="Pregled glasanja"
                    Height="45"
                    FontSize="14"
                    Click="ViewVotings_Click"/>

		</StackPanel>

	</Grid>
</UserControl>
