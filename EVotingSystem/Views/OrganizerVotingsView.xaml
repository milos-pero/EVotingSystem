<UserControl x:Class="EVotingSystem.Views.OrganizerVotingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid>
		<Button Content="← Nazad"
                Width="100"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Back_Click"/>

		<!-- MAIN CONTENT -->
		<ScrollViewer Margin="0,50,0,0">
			<StackPanel Margin="30">

				<TextBlock Text="Pregled glasanja"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

				<ListBox x:Name="VotingsList"
                         BorderBrush="Gray"
                         BorderThickness="1"
                         Padding="10"
                         FontSize="14">

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border BorderBrush="#DDD"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,12"
                                    CornerRadius="5">

								<StackPanel>

									<!-- Title -->
									<TextBlock Text="{Binding Title}"
                                               FontSize="18"
                                               FontWeight="Bold"/>

									<!-- Description -->
									<TextBlock Text="{Binding Description}"
                                               Margin="0,5,0,5"
                                               TextWrapping="Wrap"/>

									<!-- Period -->
									<TextBlock Foreground="Gray" FontSize="12">
                                        <Run Text="Period: "/>
                                        <Run Text="{Binding StartTime, StringFormat=G}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding EndTime, StringFormat=G}"/>
									</TextBlock>

									<!-- Status -->
									<TextBlock FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,6,0,6">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Foreground" Value="Green"/>
												<Setter Property="Text" Value="ACTIVE"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding Status}" Value="NotStarted">
														<Setter Property="Foreground" Value="Orange"/>
														<Setter Property="Text" Value="NOT STARTED"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding Status}" Value="Finished">
														<Setter Property="Foreground" Value="Red"/>
														<Setter Property="Text" Value="FINISHED"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>

									<!-- COUNT VOTES BUTTON -->
									<Button Content="Prebroj glasove"
                                            Width="160"
                                            Height="35"
                                            HorizontalAlignment="Left"
                                            Click="CountVotes_Click">

										<Button.Style>
											<Style TargetType="Button">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding Status}" Value="Finished">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>

									</Button>

								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>

			</StackPanel>
		</ScrollViewer>

	</Grid>
</UserControl>
