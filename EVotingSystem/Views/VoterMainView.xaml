<UserControl x:Class="EVotingSystem.Views.VoterMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ListBox x:Name="VotingsList"
         BorderBrush="Gray"
         BorderThickness="1"
         Padding="10"
         FontSize="14"
         SelectionChanged="VotingsList_SelectionChanged">

		<ListBox.ItemTemplate>
			<DataTemplate>
				<Border BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,10"
                    CornerRadius="5">
					<StackPanel>
						<TextBlock Text="{Binding Title}"
                               FontSize="18"
                               FontWeight="Bold"/>

						<TextBlock Text="{Binding Description}"
                               Margin="0,5,0,5"
                               TextWrapping="Wrap"/>

						<TextBlock Foreground="Gray"
                               FontSize="12">
                        <Run Text="Period: "/>
                        <Run Text="{Binding StartTime}"/>
                        <Run Text=" - "/>
                        <Run Text="{Binding EndTime}"/>
						</TextBlock>
					</StackPanel>
				</Border>
			</DataTemplate>
		</ListBox.ItemTemplate>

	</ListBox>


</UserControl>
