<UserControl x:Class="EVotingSystem.Views.VoterMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Button Content="Odjava"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Padding="12,6"
                Background="#C0392B"
                Foreground="White"
                FontWeight="Bold"
                Click="Logout_Click"/>

        <ScrollViewer Margin="0,40,0,0">
            <StackPanel Margin="20">

                <TextBlock Text="Trenutna glasanja"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <ListBox x:Name="VotingsList"
                         BorderBrush="Gray"
                         BorderThickness="1"
                         Padding="10"
                         FontSize="14"
                         SelectionChanged="VotingsList_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    CornerRadius="5">
                                <StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               FontSize="18"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,5,0,5"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Foreground="Gray" FontSize="12">
                                        <Run Text="Period: "/>
                                        <Run Text="{Binding StartTime, StringFormat=G}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding EndTime, StringFormat=G}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="12"
                                               FontWeight="Bold"
                                               Margin="5,5,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Setter Property="Text" Value="ACTIVE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="NotStarted">
                                                        <Setter Property="Foreground" Value="Orange"/>
                                                        <Setter Property="Text" Value="NOT STARTED"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Setter Property="Text" Value="FINISHED"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
