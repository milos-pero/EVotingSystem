<UserControl x:Class="EVotingSystem.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EVotingSystem.Views">

	<StackPanel Margin="40" Width="300" HorizontalAlignment="Center">

		<Button Content="← Nazad"
        Width="100"
        Margin="20"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Click="Back_Click"/>

		<TextBlock Text="Registracija"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

		<StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">

			<Button Content="Organizator"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="Organizer_Click"/>

			<Button Content="Glasac"
                    Width="120"
                    Click="Voter_Click"/>
		</StackPanel>
		
		<ContentControl x:Name="FormContent"/>

		<Button x:Name="RegisterButton"
            Content="Registruj se"
            Height="35"
            Margin="0,20,0,0"
            Click="Register_Click"
		/>


	</StackPanel>
</UserControl>
