<UserControl x:Class="EVotingSystem.Views.CreateVotingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer>
		<StackPanel Margin="30" Width="400">

			<TextBlock Text="Kreiranje novog glasanja"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

			<!-- Title -->
			<TextBlock Text="Naslov"/>
			<TextBox x:Name="TitleTextBox" Margin="0,5,0,10"/>

			<!-- Description -->
			<TextBlock Text="Opis"/>
			<TextBox x:Name="DescriptionTextBox"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,5,0,10"/>

			<!-- Dates -->
			<TextBlock Text="Početak glasanja"/>
			<DatePicker x:Name="StartDatePicker" Margin="0,5,0,10"/>

			<TextBlock Text="Kraj glasanja"/>
			<DatePicker x:Name="EndDatePicker" Margin="0,5,0,20"/>

			<!-- Options -->
			<TextBlock Text="Opcije (2–5)" FontWeight="Bold"/>

			<TextBox x:Name="Option1TextBox" Margin="0,5,0,5"/>
			<TextBox x:Name="Option2TextBox" Margin="0,5,0,5"/>
			<TextBox x:Name="Option3TextBox" Margin="0,5,0,5"/>
			<TextBox x:Name="Option4TextBox" Margin="0,5,0,5"/>
			<TextBox x:Name="Option5TextBox" Margin="0,5,0,20"/>


			<!-- Buttons -->
			<Button Content="Kreiraj glasanje"
                    Height="40"
                    Click="Create_Click"/>

		</StackPanel>
	</ScrollViewer>
</UserControl>
